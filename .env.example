# ==============================================================================
# BayFlow Environment Configuration
# Copy this file to .env or Backend/.env and fill in your credentials
# ==============================================================================

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Supabase / Neon / Local Postgres)
DATABASE_URL=postgresql://user:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1

# Supabase Auth / Storage (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Upstash Redis (For Distributed Locks & Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Brevo SMTP Email Relay (For OTPs & Notifications)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=BayFlow <notifications@bayflow.demo>

# Daily.co WebRTC In-App Audio Calling (Brief §8.1)
DAILY_API_KEY=your_daily_co_api_key_here
DAILY_DOMAIN=https://your-domain.daily.co
